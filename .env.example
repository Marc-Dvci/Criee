# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox). Without these, Criée runs on an in-memory PayPal double.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=EUR
# A vaulted sandbox PayPal wallet (payment token id) used by the demo wallet and simulated buyers.
CRIEE_DEMO_VAULT_ID=
# Sandbox business account that receives seller payouts by default.
SANDBOX_SELLER_EMAIL=
SANDBOX_BUYER_EMAIL=
# Public HTTPS URL. When set, Criée registers its PayPal webhook on start.
CRIEE_PUBLIC_URL=http://localhost:8000
# AI: "gemini" for live calls (Vertex AI API key), "recorded" to replay data/ai_recordings and use deterministic fallbacks.
CRIEE_AI_PROVIDER=recorded
GEMINI_API_KEY=
CRIEE_GEMINI_MODEL=gemini-3.7-flash
# Live model calls stop after this date and past these caps; recorded answers and deterministic paths keep working.
CRIEE_AI_UNTIL=2026-12-21
CRIEE_AI_DAILY_CAP=400
CRIEE_AI_DAILY_USD=1.0
CRIEE_AI_PER_VISITOR_HOURLY=30
# Platform fee in basis points, deducted from seller payouts.
CRIEE_FEE_BPS=400
# Keep a simulated Strasbourg market open (1) or not (0).
CRIEE_DEMO=1
